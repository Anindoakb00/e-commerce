# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database_name

# CORS Configuration
FRONTEND_URL=http://localhost:3001

# Stripe (Test Mode)
# Get this from https://dashboard.stripe.com/test/apikeys
# Required for checkout to work
STRIPE_SECRET_KEY=sk_test_your_key_here

# Used to build success/cancel URLs in Stripe Checkout (defaults to http://127.0.0.1:3000)
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Optional: If you set up webhooks locally via the Stripe CLI, put the webhook signing secret here
# STRIPE_WEBHOOK_SECRET=whsec_...

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0